# Python 缓存（字节码里会嵌入本机绝对路径）
__pycache__/
*.pyc
*.pyo

# 运行时产生的文件
tray_pid.txt
tray_debug.log
_dbg*.txt
_hidcap.log
*_capture.log

# 个人设置（刷新间隔 / 开机自启开关）
tray_config.json

# 三台设备的上次读数（落盘缓存）
device_last.json

# PyInstaller 产物
build/
dist/
*.spec

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# CodeBuddy 本地设置
.codebuddy/
